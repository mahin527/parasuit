{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        // File Layout
        "rootDir": "./src",
        "outDir": "./dist",

        // Environment Settings
        // See also https://aka.ms/tsconfig/module
        "module": "preserve",
        "target": "esnext",
        "types": ["node"],
        // For nodejs:
        // "lib": ["esnext"],
        // "types": ["node"],
        // and npm install -D @types/node

        // Other Outputs
        "sourceMap": true,
        // This is an application, not a published library: nothing builds
        // declaration output. Declarations are also unemittable here because
        // Prisma ORM's inferred types are only reachable through transitive
        // (pnpm) paths, which would fail with TS2742/TS2883.
        "declaration": false,
        "declarationMap": false,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Style Options
        // "noImplicitReturns": true,
        // "noImplicitOverride": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // "noFallthroughCasesInSwitch": true,
        // "noPropertyAccessFromIndexSignature": true,

        // Recommended Options
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
    },
    // Only the application source under `src` belongs to this project.
    // `prisma.config.ts` is a root-level CLI tooling file: it is not part of
    // the app program (so it stays outside `rootDir`) and must not be
    // declaration-emitted (its export type is not nameable from a public path).
    "include": ["src"],
    "exclude": ["node_modules", "dist"],
}
